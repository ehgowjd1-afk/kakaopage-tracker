":"회차 정보 역천신마 6화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 귀여벙","date":"댓글 작성 일자 26.03.03","text":"댓글 내용 노잼이 여기서 더더욱 노잼이 되었군","episode":"회차 정보 역천신마 23화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 귀여벙","date":"댓글 작성 일자 26.03.03","text":"댓글 내용 뻔한전개 저넘 살려서 대려올때부터알아봄 동료 되고 기연 나눠주고","episode":"회차 정보 역천신마 12화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 박근희","date":"댓글 작성 일자 26.03.03","text":"댓글 내용 ㅇㅏ무리 소설이라도 말이 되는 전개가 필요하다","episode":"회차 정보 역천신마 2화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 불타르","date":"댓글 작성 일자 26.02.09","text":"댓글 내용 진행이 좀 답답해지네","episode":"회차 정보 역천신마 64화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 불타르","date":"댓글 작성 일자 26.02.02","text":"댓글 내용 음.... 운룡신군한테 살아남은 과정이 좀 많이 억지인데\n운룡신군이 소교주 후보들 죽이려고 마음 먹었었다고 해도, 그런 소교주 후보들보다 훨씬 전도유망해 보이는 주인공 일행을 단순히 소교주 후보가 아니라고 착각해서 걍 보내준다는 게 좀ㅋ","episode":"회차 정보 역천신마 57화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 불타르","date":"댓글 작성 일자 26.01.29","text":"댓글 내용 남만야수궁 걸리는 게 젤 좋겠네\n전생에 갔던 데기도 하고, 간 김에 독도 좀 빨고ㅋㅋ","episode":"회차 정보 역천신마 53화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 불타르","date":"댓글 작성 일자 26.01.29","text":"댓글 내용 끝에서 두번째 문단 뭐 말 쓰다 말았네요 수정 좀","episode":"회차 정보 역천신마 52화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"프로필명 불타르","date":"댓글 작성 일자 26.01.29","text":"댓글 내용 가주독살미수에 성화무단사용인데 고작해야 몇 년 봉문시키고 끝이라니 완전 솜방망이 처벌 ㅉㅉ\n심지어 만향루에서 극가 살수들 덤벼오던데\n제대로 봉문 하고 있지도 않다는 거잖아ㅋㅋ","episode":"회차 정보 역천신마 40화","likeCount":"좋아요","replyCount":"댓글 달기"}],"commentKeywords":[{"word":"댓글","count":101},{"word":"내용","count":101},{"word":"cc","count":6},{"word":"소교주","count":4},{"word":"하고","count":4},{"word":"수고","count":3},{"word":"많으셨습니다","count":3},{"word":"작가님","count":3}],"rankSeries":{"daily":[{"date":"2026-08-09","rank":183,"change":{"type":"up","amount":23}},{"date":"2026-08-10","rank":166,"change":{"type":"up","amount":17}},{"date":"2026-08-11","rank":178,"change":{"type":"down","amount":12}},{"date":"2026-08-12","rank":219,"change":{"typ