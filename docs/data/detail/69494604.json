ount":"좋아요","replyCount":"댓글 달기"},{"author":"성빈맘","date":"26.07.14","text":"갈 길이 너무 멀구만..연기기면 뭐하나 동물가죽만 쓰는데 에휴..","episode":"선자 20화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"성빈맘","date":"26.07.14","text":"같이 있는 남방 사람들 13살 어린아이 한테 너무 공손하네~ 존대하니 주인공 어린아이란 설정이 잘못 되었나보네","episode":"선자 10화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"jangkyae30","date":"26.07.12","text":"전개되는 내용 전체를 보면 굉장히 속도감이 있는 것처럼 보이나 실제는 전개과정이 너무 늦다. 한국의 무협메니아들은 빨리빨리 속도감있게 능력을 쌓고 전개되는 것을 좋아한다. 하여 회귀하면 전생의 현경을 그대로 발휘하는 검마회귀록에 열광했다. 무협은 그래야 하는 것이다. 이 작품이 계속해서 이런 속도로 주인공에게 무위나 능력을 부여하는 건개라면 결국 외면 받을","episode":"선자 10화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"조디마지오","date":"26.07.11","text":"흠..낭자","episode":"선자 1화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"다비드","date":"26.07.10","text":"캐쉬가 아깝지않네요\n요즘은 질떨어지는 선협물이 너무많아서...\n이정도면 재밋게 볼만합니다","episode":"선자 361화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"다비드","date":"26.07.10","text":"재밋네요","episode":"선자 360화","likeCount":"좋아요","replyCount":"댓글 달기"},{"author":"세희","date":"26.07.09","text":"더 덩굴채찍?","episode":"선자 95화","likeCount":"좋아요","replyCount":"댓글 달기"}],"commentKeywords":[{"word":"계속","count":3},{"word":"위험도","count":3},{"word":"감수하고","count":3},{"word":"없고","count":3},{"word":"열심히","count":2},{"word":"건가","count":2},{"word":"통수","count":2},{"word":"이런","count":2}],"rankSeries":{"daily":[{"date":"2026-08-12","rank":272,"change":{"type":"new","amount":null}},{"date":"2026-08-13","rank":227,"change":{"type":"up","amount":45}},{"date":"2026-08-24","rank":299,"change":{"type":"new","amount":null}},{"date":"2026-09-06","rank":250,"change":{"type":"new","amount":null}}],"weekly":[{"date":"2026-08-09","rank":232,"change":{"type":"up","amount":2}},{"date":"2026-08-10","rank":246,"change":{"type":"down","amount":14}},{"date":"2026-08-11","rank":263,"change":{"type":"down","amount":17}},{"date":"2026-08-12","rank":235,"change":{"type":"up","amount":28}},{"date":"2026-08-13","rank":235,"change":{"type":"same","amount":