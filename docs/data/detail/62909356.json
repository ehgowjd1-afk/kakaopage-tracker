":"25","replyCount":"2"},{"author":"GateOfRoman","date":"24.09.18","text":"일단 죽어서 계왕성에서는 살 수 있네.","episode":"만년 후 미래에서 레벨업 22화","likeCount":"24","replyCount":"댓글 달기"},{"author":"44","date":"23.11.08","text":"읽을만은 한데 댓글알바인건지\n내용이 흥미롭고 스토리가 탄탄하다 다음스토리가 궁금해진다\n라고 2화부터 써놓은게 이상하네\n솔직히 진짜로 재밌다고 생각하면 초반부는 어떤부분이 재밌는지 적는게 일반적이고 다음이야기가 궁금하다 같은거는 끝화나 첫화정도에나 쓰는데...\n애초에 연재시작할때 10화는 뿌리고 하니 재밌으면 댓없이 달렸겠지 스토리가 궁금해진다고 안쓰고","episode":"만년 후 미래에서 레벨업 2화","likeCount":"22","replyCount":"1"},{"author":"제임스","date":"24.02.24","text":"아예 헬기를 타고 가네 ㅋㅋㅋ 개재밌노","episode":"만년 후 미래에서 레벨업 41화","likeCount":"21","replyCount":"1"},{"author":"포식활자","date":"23.11.03","text":"ㄹㅇ 동생 천재라며 그럼 미래 수련법 알려주면 더 대단해지겠네","episode":"만년 후 미래에서 레벨업 9화","likeCount":"21","replyCount":"1"}],"commentKeywords":[{"word":"뭔가","count":5},{"word":"주인공","count":5},{"word":"점점","count":4},{"word":"그림체","count":3},{"word":"먼치킨","count":3},{"word":"볼수록","count":3},{"word":"수도","count":3},{"word":"갈수록","count":3}],"rankSeries":{"daily":[{"date":"2026-08-09","rank":133,"change":{"type":"up","amount":95}},{"date":"2026-08-10","rank":171,"change":{"type":"down","amount":38}},{"date":"2026-08-11","rank":200,"change":{"type":"down","amount":29}},{"date":"2026-08-12","rank":202,"change":{"type":"down","amount":2}},{"date":"2026-08-13","rank":98,"change":{"type":"up","amount":104}},{"date":"2026-08-14","rank":178,"change":{"type":"down","amount":80}},{"date":"2026-08-15","rank":216,"change":{"type":"down","amount":38}},{"date":"2026-08-16","rank":133,"change":{"type":"up","amount":83}},{"date":"2026-08-17","rank":192,"change":{"type":"down","amount":59}},{"date":"2026-08-18","rank":241,"change":{"type":"down","amount":49}},{"date":"2026-08-19","rank":231,"change":{"type":"up","amount":10}},{"date":"2026-08-20","rank":110,"change":{"type":"up","amount":121}},{"date":"2026-08-21","rank":146,"change":{"type":"down","amount":36}},{"date":"2026-08-22","rank":187,"change":{"type":"down","amount":41}},{"date":"2026-08-23","rank":98,"change":{