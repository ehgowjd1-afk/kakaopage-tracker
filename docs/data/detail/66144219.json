plyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.04.07","text":"댓글 내용 미안하다, 루카... 서러운 거 너무 잘 알겠는데, 근데... 너무 귀여워서 할미는 웃고 있단다. ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ","episode":"회차 정보 금손 아빠가 되었다 474화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.12.15","text":"댓글 내용 역시 사람은 죽을 때까지 배워야 한다는 말이 맞네요 ㅋㅋ 에반에게 보이지 않던 모습들이 새록새록~~","episode":"회차 정보 금손 아빠가 되었다 401화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.03.28","text":"댓글 내용 복숭아가 우르르","episode":"회차 정보 금손 아빠가 되었다 218화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.03.14","text":"댓글 내용 준의 첫 편지 잘 받았어요\n힘듦을 힘듦으로 스스로 받아 들이는 것도\n상처를 낫게 하는 과정 같아요.\n말로 표현하기 어려움을 느끼는데에서\n폭풍 공감을 했네요","episode":"회차 정보 금손 아빠가 되었다 75화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.03.12","text":"댓글 내용 신부님도 수녀님도 너무 재밌고 좋은 분들이네요ㅋㅋㅋ","episode":"회차 정보 금손 아빠가 되었다 56화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.03.26","text":"댓글 내용 아 한국인한테 쇼파는 비싼 등받이라고 ㅋㅋ","episode":"회차 정보 금손 아빠가 되었다 93화","likeCount":"좋아요","replyCount":"댓글"},{"date":"댓글 작성 일자 25.12.15","text":"댓글 내용 지금까지 본 에반 중에 오늘이 제일 존경스러워요. 애들을 휘어잡아서 교육적인 방향으로 틀어버리다니","episode":"회차 정보 금손 아빠가 되었다 401화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.04.18","text":"댓글 내용 보통 저러고 당일 저녁이 부모님 찾으며 우는게 애기들이죠 ㅋㅋ","episode":"회차 정보 금손 아빠가 되었다 233화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 25.04.26","text":"댓글 내용 아싸일중독자가 감동먹은거임? 지금?","episode":"회차 정보 금손 아빠가 되었다 78화","likeCount":"좋아요","replyCount":"댓글 달기"}],"commentKeywords":[{"word":"댓글","count":150},{"word":"내용","count":150},{"word":"루카","count":14},{"word":"레니","count":7},{"word":"루카가","count":7},{"word":"같아요","count":7},{"word":"귀여워","count":7},{"word":"준이","count":6}],"rankSeries":{"daily":[{"date":"2026-08-09","rank":98,"change":{"type":"down","amount":9}},{"date":"2026-08-10","rank":121,"change":{"type":"down","amount":23}},{"date":"2026-08-11","rank":116,"change":{"type":"up","amount":5}},{"date":"2026-08-12","rank":128,"change":{"type":"down","amount":12}},{"date":"2026-08-13","rank":11