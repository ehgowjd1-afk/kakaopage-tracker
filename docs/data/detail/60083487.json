unt":"22"},{"author":"별사탕짬뽕","date":"22.09.03","text":"뭔가....작화만 괜찮고 내용이 이상함","episode":"악당 공작가의 실세 막내딸입니다 8화","likeCount":"759","replyCount":"21"},{"author":"리엘","date":"22.09.02","text":"왠지 키안이 성흔의 왕 같은데","episode":"악당 공작가의 실세 막내딸입니다 14화","likeCount":"738","replyCount":"27"},{"author":"하루","date":"22.09.02","text":"베일 쓴 유령 왠지 공작부인일 것 같은 예감!!","episode":"악당 공작가의 실세 막내딸입니다 16화","likeCount":"733","replyCount":"16"},{"author":"데드로즈","date":"22.09.25","text":"아... 너무 가슴아프네... 누군가의 죽음을 목도하며 자신의 정체를 들키고, 그사람이 부탁을 해서 대신 인생은 살아주는데... 그사람의 이름은 사용할수 없다니... 가슴아프다 ㅠㅡㅠ","episode":"악당 공작가의 실세 막내딸입니다 24화","likeCount":"713","replyCount":"2"},{"author":"Laurel","date":"22.09.02","text":"빙의하면 정신연령도 그 나이가 되는건가. 굳이 빙의를 넣고 애기같이 행동하는 로판들은 참 이해가 안감","episode":"악당 공작가의 실세 막내딸입니다 2화","likeCount":"703","replyCount":"18"},{"author":"데려가","date":"22.09.02","text":"클리셰 범벅이다\n답답하고","episode":"악당 공작가의 실세 막내딸입니다 9화","likeCount":"700","replyCount":"16"},{"author":"루루","date":"22.09.02","text":"아버님 여보당신 숨소리가 자장가고 수면제인걸.. 나 반수면상태야ㅠㅠ","episode":"악당 공작가의 실세 막내딸입니다 11화","likeCount":"665","replyCount":"6"}],"commentKeywords":[{"word":"장발","count":28},{"word":"키안","count":8},{"word":"뭔가","count":5},{"word":"아버님","count":5},{"word":"키안이","count":5},{"word":"죽어서도","count":4},{"word":"계속","count":4},{"word":"본인이","count":4}],"rankSeries":{"daily":[{"date":"2026-08-10","rank":292,"change":{"type":"new","amount":null}},{"date":"2026-08-11","rank":175,"change":{"type":"up","amount":117}},{"date":"2026-08-12","rank":239,"change":{"type":"down","amount":64}},{"date":"2026-08-17","rank":267,"change":{"type":"new","amount":null}},{"date":"2026-08-18","rank":199,"change":{"type":"up","amount":68}},{"date":"2026-08-19","rank":252,"change":{"type":"down","amount":53}},{"date":"2026-08-20","rank":296,"change":{"type":"down","amount":44}},{"date":"2026-08-25","rank":119,"change":{"type":"new","amount":null}},{"date":"2026-08-26","rank":181,"change":{"type":"down","amount":62}},{"date":"2026-08-27","rank":220,"change":n