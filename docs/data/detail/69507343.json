xt":"댓글 내용 나이스 타이밍~~~~~~\n제발 눈치좀 빨리채고\n기억도 돌아와라~~~~~~","episode":"회차 정보 낯선 상사 10화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.09.01","text":"댓글 내용 저게 엄마야!!\n자기가 버려줘서 그 덕에 도헌이 만났대\n말이야 방구야","episode":"회차 정보 낯선 상사 109화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.08.27","text":"댓글 내용 끝! 자식으로부터 독립하세요 아주머니.","episode":"회차 정보 낯선 상사 87화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.08.27","text":"댓글 내용 쌍으로 천박하긴","episode":"회차 정보 낯선 상사 82화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.08.27","text":"댓글 내용 근데 도헌엄마님 참 희한하시다. 친구 망친 남자와 여자를 사돈으로 맞고 싶으실까? 쳐다도 보기 싫지 않나? 되게 모순적인데? 친아들 맞죠?","episode":"회차 정보 낯선 상사 81화","likeCount":"좋아요","replyCount":"댓글 달기"},{"date":"댓글 작성 일자 26.08.27","text":"댓글 내용 그러네. 두 여자가 밥도 못 먹고 체하는 장면이 아주 팝콘에 꿀을 잔뜩 발라서 진저리가 처질 정도로 달고 재밌네. 누님 평점 만점 줘야겠네요.","episode":"회차 정보 낯선 상사 56화","likeCount":"좋아요","replyCount":"댓글 달기"}],"commentKeywords":[{"word":"댓글","count":111},{"word":"내용","count":111},{"word":"응원합니다","count":14},{"word":"도헌이","count":6},{"word":"윤경이","count":4},{"word":"앞으로","count":3},{"word":"계속","count":3},{"word":"둘이","count":3}],"rankSeries":{"daily":[{"date":"2026-08-09","rank":58,"change":{"type":"same","amount":null}},{"date":"2026-08-10","rank":58,"change":{"type":"same","amount":null}},{"date":"2026-08-11","rank":56,"change":{"type":"up","amount":2}},{"date":"2026-08-12","rank":68,"change":{"type":"down","amount":12}},{"date":"2026-08-13","rank":74,"change":{"type":"down","amount":6}},{"date":"2026-08-14","rank":70,"change":{"type":"up","amount":4}},{"date":"2026-08-15","rank":64,"change":{"type":"up","amount":6}},{"date":"2026-08-16","rank":68,"change":{"type":"down","amount":4}},{"date":"2026-08-17","rank":64,"change":{"type":"up","amount":4}},{"date":"2026-08-18","rank":48,"change":{"type":"up","amount":16}},{"date":"2026-08-19","rank":64,"change":{"type":"down","amount":16}},{"date":"2026-08-20","rank":51,"change":{"type":"up","amount":13}},{"date":"2026-08-21","rank":51